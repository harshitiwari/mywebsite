<!doctype html>
{% comment %}
  Blog pages start with the Lorenz background off so long prose stays readable.
  Rendering the class here (rather than waiting for ambient-controls.js) avoids
  a flash of the animation on a cold load. The reader can still switch it on,
  and ambient-controls.js re-applies this per URL during seamless navigation.
{% endcomment %}
{% assign reading_page = false %}
{% if page.layout == 'post' or page.layout == 'distill' %}
  {% assign reading_page = true %}
{% elsif page.url contains '/blog' %}
  {% assign reading_page = true %}
{% endif %}
<html lang="{{ site.lang }}" class="{% if reading_page %}lorenz-disabled{% endif %}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/lorenz.css' | relative_url | bust_file_cache }}">
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <style>
      /* Critical positioning stays fresh during local preview even when the
         compiled theme stylesheet is cached by the browser. */
      @media (min-width: 992px) {
        #music-player.music-player {
          bottom: 10px;
          left: 10px;
          width: 246px;
          transform: none;
        }
      }
      .post .social .contact-icons { font-size: 2rem; }
      .post .social .contact-icons a img { width: 1.6rem; height: 1.6rem; margin-bottom: .5rem; }
      .post .social .contact-icons a svg { width: 1.75rem; height: 2rem; margin-bottom: .25rem; }
    </style>
    <canvas id="lorenz-canvas"></canvas>
    {% include ambient-controls.liquid %}

    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'left' %}
          <div class="row">
            <!-- sidebar, table of contents -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">
              {{ content }}
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-10">
              {{ content }}
            </div>
            <!-- sidebar, table of contents -->
            <div class="col-sm-2">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
    <script src="{{ '/assets/js/lorenz.js' | relative_url | bust_file_cache }}"></script>
    <script src="{{ '/assets/js/ambient-controls.js' | relative_url | bust_file_cache }}"></script>
    <script src="{{ '/assets/js/seamless-navigation.js' | relative_url | bust_file_cache }}"></script>
  </body>
</html>
